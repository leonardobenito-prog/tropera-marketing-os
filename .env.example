# Copia este archivo a .env y completa con tus valores reales.
# Nunca subas .env a git — ya está en .gitignore.

# PostgreSQL — usa Neon, Supabase, Vercel Postgres o una instancia local.
DATABASE_URL="postgresql://usuario:password@localhost:5432/tropera_os"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# Integraciones futuras (Fase 12 del roadmap) — dejar vacío por ahora.
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GA4_PROPERTY_ID=""
